# TradingAgents — Environment variable configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Only set the keys for providers you actually use.

# ── LLM Provider API Keys ─────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=

# ── Data Provider API Keys ────────────────────────────────────────────────────
CRYPTOPANIC_API_TOKEN=
COINGECKO_API_KEY=

# ── TradingAgents path overrides (optional) ───────────────────────────────────
# TRADINGAGENTS_RESULTS_DIR=~/.tradingagents/logs
# TRADINGAGENTS_CACHE_DIR=~/.tradingagents/cache
# TRADINGAGENTS_MEMORY_LOG_PATH=~/.tradingagents/memory/trading_memory.md
# TRADINGAGENTS_JOURNAL_DB=~/.tradingagents/cache/research_journal.sqlite
# TRADINGAGENTS_LOG_LEVEL=INFO

# ── Per-provider key overrides via TRADINGAGENTS_ prefix (optional) ───────────
# Use these when you need a different key for TradingAgents than your global
# env var. For example:
# TRADINGAGENTS_DEEPSEEK_API_KEY=sk-tradingagents-specific-key
# TRADINGAGENTS_OPENAI_API_KEY=sk-tradingagents-specific-key
