{
  "name": "@lunaperception/api",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @lunaperception/database db:generate && tsc -p tsconfig.app.json",
    "dev": "pnpm build && node --watch ../../dist/apps/api/src/main.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node ../../dist/apps/api/src/main.js",
    "start:worker": "node ../../dist/apps/api/src/jobs/research-worker.js",
    "typecheck": "pnpm --filter @lunaperception/database db:generate && tsc -p tsconfig.app.json --noEmit",
    "test": "npm run build && node --test ../../dist/apps/api/test/api-contract.test.js ../../dist/apps/api/test/api-startup.test.js ../../dist/apps/api/test/workspace-metadata.test.js"
  },
  "dependencies": {
    "@lunaperception/database": "workspace:*"
  }
}
