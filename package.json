{
  "name": "lunaperception",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "description": "Monorepo for the LunaPerception crypto research product.",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "build:api": "tsc -p apps/api/tsconfig.app.json",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "ai:install": "python -m pip install -e \"./apps/ai-service[dev]\"",
    "ai:test": "pnpm --filter @lunaperception/ai-service test"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "bullmq": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "ioredis": "^5.0.0",
    "pg": "^8.11.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "eslint": "^10.3.0",
    "turbo": "^2.5.8",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.59.3"
  }
}
