generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id
  email       String?  @unique
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships WorkspaceMembership[]

  @@map("users")
}

model Workspace {
  id        String   @id
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships WorkspaceMembership[]

  @@map("workspaces")
}

model WorkspaceMembership {
  id          String   @id
  workspaceId String   @map("workspace_id")
  userId      String   @map("user_id")
  role        String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId], map: "idx_workspace_memberships_workspace_user")
  @@index([userId, workspaceId], map: "idx_workspace_memberships_user_workspace")
  @@map("workspace_memberships")
}

model ResearchRun {
  id                      String   @id
  workspaceId             String   @default("local") @map("workspace_id")
  symbol                  String
  assetClass              String   @map("asset_class")
  timeframe               String?
  status                  String
  startedAt               DateTime @map("started_at") @db.Timestamptz(6)
  completedAt             DateTime? @map("completed_at") @db.Timestamptz(6)
  deepThinkModel          String?  @map("deep_think_model")
  quickThinkModel         String?  @map("quick_think_model")
  llmProvider             String?  @map("llm_provider")
  configHash              String?  @map("config_hash")
  marketSnapshotId        String?  @map("market_snapshot_id")
  signalSnapshotId        String?  @map("signal_snapshot_id")
  debateId                String?  @map("debate_id")
  thesisId                String?  @map("thesis_id")
  decisionId              String?  @map("decision_id")
  userDecisionId          String?  @map("user_decision_id")
  outcomeReviewId         String?  @map("outcome_review_id")
  degradationReasonsJson  Json     @default("[]") @map("degradation_reasons_json")
  missingCoreDataJson     Json     @default("[]") @map("missing_core_data_json")
  missingOptionalDataJson Json     @default("[]") @map("missing_optional_data_json")
  payloadJson             Json     @map("payload_json")

  marketSnapshots     MarketSnapshot[]
  signalSnapshots     SignalSnapshot[]
  debates             Debate[]
  agentOpinions       AgentOpinion[]
  runEvents           RunEvent[]
  tradeTheses         TradeThesis[]
  llmCalls            LlmCall[]
  dataFreshnessChecks DataFreshnessCheck[]

  @@index([status, startedAt(sort: Desc)], map: "idx_research_runs_status")
  @@index([workspaceId, startedAt(sort: Desc)], map: "idx_research_runs_workspace_created")
  @@map("research_runs")
}

model ResearchJob {
  id                      String    @id
  runId                   String    @map("run_id")
  workspaceId             String    @map("workspace_id")
  queueBackend            String    @map("queue_backend")
  queueName               String?   @map("queue_name")
  queueJobId              String?   @map("queue_job_id")
  status                  String
  requestJson             Json      @map("request_json")
  attempts                Int       @default(0)
  maxAttempts             Int       @default(1) @map("max_attempts")
  progressJson            Json      @default("{}") @map("progress_json")
  heartbeatAt             DateTime? @map("heartbeat_at") @db.Timestamptz(6)
  cancellationRequestedAt DateTime? @map("cancellation_requested_at") @db.Timestamptz(6)
  timeoutAt               DateTime? @map("timeout_at") @db.Timestamptz(6)
  resultSummaryJson       Json?     @map("result_summary_json")
  errorCode               String?   @map("error_code")
  errorMessage            String?   @map("error_message")
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt               DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt             DateTime? @map("completed_at") @db.Timestamptz(6)
  updatedAt               DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([runId, createdAt(sort: Desc)], map: "idx_research_jobs_run_created")
  @@index([workspaceId, status, createdAt(sort: Desc)], map: "idx_research_jobs_workspace_status")
  @@index([status, heartbeatAt], map: "idx_research_jobs_heartbeat")
  @@map("research_jobs")
}

model MarketSnapshot {
  id              String    @id
  workspaceId     String    @default("local") @map("workspace_id")
  researchRunId   String?   @map("research_run_id")
  symbol          String
  capturedAt      DateTime  @map("captured_at") @db.Timestamptz(6)
  currentPrice    Float?    @map("current_price")
  source          String
  sourceTimestamp DateTime? @map("source_timestamp") @db.Timestamptz(6)
  payloadJson     Json      @map("payload_json")

  researchRun ResearchRun? @relation(fields: [researchRunId], references: [id])

  @@index([workspaceId, researchRunId], map: "idx_market_snapshots_workspace_run")
  @@index([workspaceId, symbol, capturedAt(sort: Desc)], map: "idx_market_snapshots_workspace_symbol")
  @@map("market_snapshots")
}

model SignalSnapshot {
  id                    String   @id
  workspaceId           String   @default("local") @map("workspace_id")
  researchRunId         String   @map("research_run_id")
  symbol                String
  capturedAt            DateTime @map("captured_at") @db.Timestamptz(6)
  compositeSignalId     String?  @map("composite_signal_id")
  signalCount           Int      @map("signal_count")
  bullishCount          Int      @map("bullish_count")
  bearishCount          Int      @map("bearish_count")
  neutralCount          Int      @map("neutral_count")
  staleCount            Int      @map("stale_count")
  unknownFreshnessCount Int      @map("unknown_freshness_count")
  payloadJson           Json     @map("payload_json")

  researchRun ResearchRun @relation(fields: [researchRunId], references: [id])

  @@index([workspaceId, researchRunId], map: "idx_signal_snapshots_workspace_run")
  @@index([workspaceId, symbol, capturedAt(sort: Desc)], map: "idx_signal_snapshots_workspace_symbol")
  @@map("signal_snapshots")
}

model ResearchSnapshot {
  id                  String   @id
  workspaceId         String   @default("local") @map("workspace_id")
  researchRunId       String   @map("research_run_id")
  symbol              String
  capturedAt          DateTime @map("captured_at") @db.Timestamptz(6)
  timeContext         String   @map("time_context")
  symbolViewJson      Json     @default("{}") @map("symbol_view_json")
  trackedItemsJson    Json     @default("[]") @map("tracked_items_json")
  dataQualityJson     Json     @default("{}") @map("data_quality_json")
  sourceArtifactsJson Json     @default("{}") @map("source_artifacts_json")
  payloadJson         Json     @map("payload_json")

  @@unique([workspaceId, researchRunId], map: "idx_research_snapshots_workspace_run")
  @@index([workspaceId, symbol, capturedAt(sort: Desc)], map: "idx_research_snapshots_workspace_symbol")
  @@map("research_snapshots")
}

model ResearchContinuityEntry {
  id                  String   @id
  workspaceId         String   @default("local") @map("workspace_id")
  symbol              String
  researchRunId       String   @map("research_run_id")
  currentSnapshotId   String?  @map("current_snapshot_id")
  previousEntryId     String?  @map("previous_entry_id")
  entryType           String   @map("entry_type")
  status              String
  generatedAt         DateTime @map("generated_at") @db.Timestamptz(6)
  summary             String
  sectionsJson        Json     @default("[]") @map("sections_json")
  eventsJson          Json     @default("[]") @map("events_json")
  snapshotQualityJson Json     @default("{}") @map("snapshot_quality_json")
  sourceRunIdsJson    Json     @default("[]") @map("source_run_ids_json")
  writerMetadataJson  Json     @default("{}") @map("writer_metadata_json")
  payloadJson         Json     @map("payload_json")

  @@index([workspaceId, symbol, generatedAt(sort: Desc)], map: "idx_research_continuity_entries_symbol")
  @@index([workspaceId, researchRunId, generatedAt(sort: Desc)], map: "idx_research_continuity_entries_run")
  @@map("research_continuity_entries")
}

model ResearchContinuityDebugAccessAudit {
  id                String   @id
  workspaceId       String?  @map("workspace_id")
  entryId           String   @map("entry_id")
  researchRunId     String?  @map("research_run_id")
  symbol            String?
  requestedByUserId String?  @map("requested_by_user_id")
  decision          String
  reason            String
  requestedAt       DateTime @map("requested_at") @db.Timestamptz(6)
  metadataJson      Json     @default("{}") @map("metadata_json")

  @@index([workspaceId, requestedAt(sort: Desc)], map: "idx_research_continuity_debug_audits_workspace_requested")
  @@index([workspaceId, entryId], map: "idx_research_continuity_debug_audits_workspace_entry")
  @@index([workspaceId, decision, requestedAt(sort: Desc)], map: "idx_research_continuity_debug_audits_workspace_decision")
  @@map("research_continuity_debug_access_audits")
}

model ResearchContinuityRepairRun {
  id                  String    @id
  workspaceId         String    @map("workspace_id")
  requestedByUserId   String    @map("requested_by_user_id")
  requestedAt         DateTime  @map("requested_at") @db.Timestamptz(6)
  completedAt         DateTime? @map("completed_at") @db.Timestamptz(6)
  dryRun              Boolean   @map("dry_run")
  status              String
  idempotencyKey      String?   @map("idempotency_key")
  filtersJson         Json      @map("filters_json")
  requestedCount      Int       @default(0) @map("requested_count")
  repairedCount       Int       @default(0) @map("repaired_count")
  skippedCount        Int       @default(0) @map("skipped_count")
  failedCount         Int       @default(0) @map("failed_count")
  createdEntryIdsJson Json      @default("[]") @map("created_entry_ids_json")
  resultsJson         Json      @default("[]") @map("results_json")
  errorMessage        String?   @map("error_message")

  @@index([workspaceId, requestedAt(sort: Desc)], map: "idx_research_continuity_repair_runs_workspace_requested")
  @@index([workspaceId, status, requestedAt(sort: Desc)], map: "idx_research_continuity_repair_runs_workspace_status")
  @@unique([workspaceId, idempotencyKey], map: "idx_research_continuity_repair_runs_idempotency")
  @@map("research_continuity_repair_runs")
}

model ResearchContinuityWorkspaceSettings {
  workspaceId                   String    @id @map("workspace_id")
  scheduledRepairMode           String    @default("disabled") @map("scheduled_repair_mode")
  scheduledRepairCaseTypesJson  Json      @default("[\"missing_continuity\",\"legacy_evidence\"]") @map("scheduled_repair_case_types_json")
  scheduledRepairIntervalHours  Int       @default(24) @map("scheduled_repair_interval_hours")
  scheduledRepairLookbackDays   Int       @default(30) @map("scheduled_repair_lookback_days")
  scheduledRepairLimit          Int       @default(25) @map("scheduled_repair_limit")
  nextScheduledRepairDueAt      DateTime? @map("next_scheduled_repair_due_at") @db.Timestamptz(6)
  lastScheduledRepairAt         DateTime? @map("last_scheduled_repair_at") @db.Timestamptz(6)
  lastScheduledRepairRunId      String?   @map("last_scheduled_repair_run_id")
  schedulerLeaseOwner           String?   @map("scheduler_lease_owner")
  schedulerLeaseExpiresAt       DateTime? @map("scheduler_lease_expires_at") @db.Timestamptz(6)
  lastSchedulerAttemptAt        DateTime? @map("last_scheduler_attempt_at") @db.Timestamptz(6)
  lastSchedulerSuccessAt        DateTime? @map("last_scheduler_success_at") @db.Timestamptz(6)
  lastSchedulerError            String?   @map("last_scheduler_error")
  consecutiveSchedulerFailures  Int       @default(0) @map("consecutive_scheduler_failures")
  nextSchedulerRetryAt          DateTime? @map("next_scheduler_retry_at") @db.Timestamptz(6)
  updatedByUserId               String?   @map("updated_by_user_id")
  updatedAt                     DateTime  @map("updated_at") @db.Timestamptz(6)

  @@index([scheduledRepairMode, nextScheduledRepairDueAt], map: "idx_research_continuity_workspace_settings_due")
  @@index([scheduledRepairMode, nextSchedulerRetryAt, nextScheduledRepairDueAt, schedulerLeaseExpiresAt], map: "idx_research_continuity_workspace_settings_worker_due")
  @@index([updatedAt(sort: Desc)], map: "idx_research_continuity_workspace_settings_updated")
  @@map("research_continuity_workspace_settings")
}

model ResearchContinuityState {
  id                         String   @id
  workspaceId                String   @default("local") @map("workspace_id")
  symbol                     String
  currentSnapshotId          String?  @map("current_snapshot_id")
  latestEntryId              String?  @map("latest_entry_id")
  latestRunId                String?  @map("latest_run_id")
  currentViewJson            Json     @default("{}") @map("current_view_json")
  activeItemsJson            Json     @default("[]") @map("active_items_json")
  recentResolvedItemsJson    Json     @default("[]") @map("recent_resolved_items_json")
  recentInvalidatedItemsJson Json     @default("[]") @map("recent_invalidated_items_json")
  dataQualityJson            Json     @default("{}") @map("data_quality_json")
  updatedAt                  DateTime @map("updated_at") @db.Timestamptz(6)
  payloadJson                Json     @map("payload_json")

  @@unique([workspaceId, symbol], map: "idx_research_continuity_states_symbol")
  @@index([workspaceId, updatedAt(sort: Desc)], map: "idx_research_continuity_states_workspace")
  @@map("research_continuity_states")
}

model Debate {
  id              String   @id
  workspaceId     String   @default("local") @map("workspace_id")
  researchRunId   String?  @map("research_run_id")
  symbol          String
  consensusStance String   @map("consensus_stance")
  conflictLevel   String   @map("conflict_level")
  createdAt       DateTime @map("created_at") @db.Timestamptz(6)
  payloadJson     Json     @map("payload_json")

  researchRun   ResearchRun?   @relation(fields: [researchRunId], references: [id])
  agentOpinions AgentOpinion[]

  @@index([workspaceId, researchRunId], map: "idx_debates_workspace_run")
  @@map("debates")
}

model AgentOpinion {
  id            String   @id
  workspaceId   String   @default("local") @map("workspace_id")
  debateId      String?  @map("debate_id")
  researchRunId String?  @map("research_run_id")
  agentName     String   @map("agent_name")
  agentRole     String   @map("agent_role")
  stance        String
  confidence    Float?
  createdAt     DateTime @map("created_at") @db.Timestamptz(6)
  payloadJson   Json     @map("payload_json")

  debate      Debate?      @relation(fields: [debateId], references: [id])
  researchRun ResearchRun? @relation(fields: [researchRunId], references: [id])

  @@index([workspaceId, debateId], map: "idx_agent_opinions_workspace_debate")
  @@map("agent_opinions")
}

model RunEvent {
  id            String   @id
  workspaceId   String   @default("local") @map("workspace_id")
  researchRunId String   @map("research_run_id")
  thesisId      String?  @map("thesis_id")
  eventType     String   @map("event_type")
  createdAt     DateTime @map("created_at") @db.Timestamptz(6)
  message       String
  payloadJson   Json     @map("payload_json")

  researchRun ResearchRun @relation(fields: [researchRunId], references: [id])

  @@index([researchRunId, createdAt], map: "idx_run_events_run")
  @@index([workspaceId, createdAt], map: "idx_run_events_workspace_created")
  @@map("run_events")
}

model TradeThesis {
  id            String   @id
  workspaceId   String   @default("local") @map("workspace_id")
  researchRunId String?  @map("research_run_id")
  symbol        String
  direction     String
  setupType     String   @map("setup_type")
  confidence    Float?
  createdAt     DateTime @map("created_at") @db.Timestamptz(6)
  payloadJson   Json     @map("payload_json")

  researchRun    ResearchRun?    @relation(fields: [researchRunId], references: [id])
  scenarios      Scenario[]
  watchlistItems WatchlistItem[]
  alerts         Alert[]
  userDecisions  UserDecision[]
  outcomeReviews OutcomeReview[]
  thesisEvaluations ThesisEvaluation[]
  thesisEvaluationRuns ThesisEvaluationRun[]
  llmCalls       LlmCall[]

  @@index([workspaceId, createdAt(sort: Desc)], map: "idx_trade_theses_workspace_created")
  @@map("trade_theses")
}

model Scenario {
  id                  String @id
  workspaceId         String @default("local") @map("workspace_id")
  thesisId            String @map("thesis_id")
  probabilityBand     String @map("probability_band")
  suggestedUserAction String @map("suggested_user_action")
  payloadJson         Json   @map("payload_json")

  thesis TradeThesis @relation(fields: [thesisId], references: [id])

  @@index([workspaceId, thesisId], map: "idx_scenarios_workspace_thesis")
  @@map("scenarios")
}

model ScenarioEvaluation {
  id                       String    @id
  workspaceId              String    @map("workspace_id")
  scenarioId               String    @map("scenario_id")
  thesisId                 String    @map("thesis_id")
  researchRunId            String?   @map("research_run_id")
  symbol                   String
  marketType               String    @default("spot") @map("market_type")
  horizon                  String    @default("unknown")
  evaluatedAt              DateTime  @default(now()) @map("evaluated_at") @db.Timestamptz(6)
  evaluationWindow         Json      @default("{}") @map("evaluation_window")
  result                   String
  triggerHit               Boolean?  @map("trigger_hit")
  invalidationHit          Boolean?  @map("invalidation_hit")
  targetHit                Boolean?  @map("target_hit")
  startPrice               Float?    @map("start_price")
  endPrice                 Float?    @map("end_price")
  maxFavorableExcursion    Float?    @map("max_favorable_excursion")
  maxAdverseExcursion      Float?    @map("max_adverse_excursion")
  dataQuality              String    @default("insufficient") @map("data_quality")
  warningsJson             Json      @default("[]") @map("warnings_json")
  evidenceJson             Json      @default("{}") @map("evidence_json")
  payloadJson              Json      @default("{}") @map("payload_json")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([workspaceId, scenarioId, evaluatedAt(sort: Desc)], map: "idx_scenario_evaluations_scenario")
  @@map("scenario_evaluations")
}

model TradePlaybook {
  id               String   @id
  workspaceId      String   @map("workspace_id")
  sourceScenarioId String   @map("source_scenario_id")
  sourceThesisId   String   @map("source_thesis_id")
  symbol           String
  marketType       String   @map("market_type")
  direction        String
  horizon          String   @default("unknown")
  payloadJson      Json     @default("{}") @map("payload_json")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([workspaceId, sourceScenarioId, createdAt(sort: Desc)], map: "idx_trade_playbooks_scenario")
  @@map("trade_playbooks")
}

model BacktestRun {
  id              String    @id
  workspaceId     String    @map("workspace_id")
  playbookId      String    @map("playbook_id")
  status          String
  assumptionsJson Json      @default("{}") @map("assumptions_json")
  resultJson      Json      @default("{}") @map("result_json")
  warningsJson    Json      @default("[]") @map("warnings_json")
  dataQuality     String    @default("insufficient") @map("data_quality")
  payloadJson     Json      @default("{}") @map("payload_json")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(6)

  @@index([workspaceId, playbookId, createdAt(sort: Desc)], map: "idx_backtest_runs_playbook")
  @@map("backtest_runs")
}

model BacktestTradeEvent {
  id            String   @id
  workspaceId   String   @map("workspace_id")
  backtestRunId String   @map("backtest_run_id")
  eventIndex    Int      @map("event_index")
  eventType     String   @map("event_type")
  eventTime     DateTime @default(now()) @map("event_time") @db.Timestamptz(6)
  price         Float?
  payloadJson   Json     @default("{}") @map("payload_json")

  @@index([workspaceId, backtestRunId, eventIndex], map: "idx_backtest_trade_events_run")
  @@map("backtest_trade_events")
}

model ScenarioDecisionItemState {
  id          String
  workspaceId String    @map("workspace_id")
  status      String
  dueAt       DateTime? @map("due_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  payloadJson Json      @default("{}") @map("payload_json")

  @@id([workspaceId, id])
  @@map("scenario_decision_item_states")
}

model Signal {
  id              String    @id
  workspaceId     String    @default("local") @map("workspace_id")
  symbol          String
  signalType      String    @map("signal_type")
  direction       String
  confidence      Float?
  observedAt      DateTime  @map("observed_at") @db.Timestamptz(6)
  source          String
  sourceTimestamp DateTime? @map("source_timestamp") @db.Timestamptz(6)
  payloadJson     Json      @map("payload_json")

  @@index([workspaceId, observedAt(sort: Desc)], map: "idx_signals_workspace_observed")
  @@map("signals")
}

model Watchlist {
  id          String   @id
  workspaceId String   @default("local") @map("workspace_id")
  name        String
  enabled     Int
  createdAt   DateTime @map("created_at") @db.Timestamptz(6)
  payloadJson Json     @map("payload_json")

  items WatchlistItem[]

  @@unique([workspaceId, name], map: "idx_watchlists_workspace_name")
  @@index([workspaceId, createdAt(sort: Desc)], map: "idx_watchlists_workspace_created")
  @@map("watchlists")
}

model WatchlistItem {
  id          String   @id
  workspaceId String   @default("local") @map("workspace_id")
  watchlistId String   @map("watchlist_id")
  itemType    String   @map("item_type")
  symbol      String?
  thesisId    String?  @map("thesis_id")
  setupType   String?  @map("setup_type")
  enabled     Int
  createdAt   DateTime @map("created_at") @db.Timestamptz(6)
  payloadJson Json     @map("payload_json")

  watchlist Watchlist    @relation(fields: [watchlistId], references: [id])
  thesis    TradeThesis? @relation(fields: [thesisId], references: [id])
  alerts    Alert[]

  @@index([workspaceId, watchlistId], map: "idx_watchlist_items_workspace_watchlist")
  @@map("watchlist_items")
}

model Alert {
  id              String    @id
  workspaceId     String    @default("local") @map("workspace_id")
  alertType       String    @map("alert_type")
  symbol          String
  thesisId        String?   @map("thesis_id")
  watchlistItemId String?   @map("watchlist_item_id")
  triggerKey      String?   @map("trigger_key")
  createdAt       DateTime  @map("created_at") @db.Timestamptz(6)
  readAt          DateTime? @map("read_at") @db.Timestamptz(6)
  message         String
  payloadJson     Json      @map("payload_json")

  thesis        TradeThesis?   @relation(fields: [thesisId], references: [id])
  watchlistItem WatchlistItem? @relation(fields: [watchlistItemId], references: [id])

  @@index([workspaceId, createdAt(sort: Desc)], map: "idx_alerts_workspace_created")
  @@index([workspaceId, symbol, createdAt(sort: Desc)], map: "idx_alerts_workspace_symbol")
  @@index([workspaceId, thesisId, createdAt(sort: Desc)], map: "idx_alerts_workspace_thesis")
  @@map("alerts")
}

model MarketBrief {
  id              String   @id
  workspaceId     String   @default("local") @map("workspace_id")
  briefDate       DateTime @map("brief_date") @db.Date
  watchlistName   String   @map("watchlist_name")
  title           String
  createdAt       DateTime @map("created_at") @db.Timestamptz(6)
  previousBriefId String?  @map("previous_brief_id")
  payloadJson     Json     @map("payload_json")

  @@index([workspaceId, createdAt(sort: Desc)], map: "idx_market_briefs_workspace_created")
  @@map("market_briefs")
}

model UserDecision {
  id          String   @id
  thesisId    String   @map("thesis_id")
  action      String
  decidedAt   DateTime @map("decided_at") @db.Timestamptz(6)
  userNotes   String   @map("user_notes")
  payloadJson Json     @map("payload_json")

  thesis TradeThesis @relation(fields: [thesisId], references: [id])

  @@map("user_decisions")
}

model OutcomeReview {
  id          String   @id
  thesisId    String   @map("thesis_id")
  result      String
  reviewedAt  DateTime @map("reviewed_at") @db.Timestamptz(6)
  invalidated Int
  payloadJson Json     @map("payload_json")

  thesis TradeThesis @relation(fields: [thesisId], references: [id])
  thesisEvaluations ThesisEvaluation[]

  @@map("outcome_reviews")
}

model ThesisEvaluation {
  id                       String   @id
  workspaceId              String   @default("local") @map("workspace_id")
  thesisId                 String   @map("thesis_id")
  outcomeReviewId          String?  @map("outcome_review_id")
  symbol                   String
  windowDays               Int      @map("window_days")
  evaluationStart          DateTime @map("evaluation_start") @db.Date
  evaluationEnd            DateTime @map("evaluation_end") @db.Date
  evaluatedAt              DateTime @map("evaluated_at") @db.Timestamptz(6)
  result                   String
  maxFavorableExcursion    Float?   @map("max_favorable_excursion")
  maxAdverseExcursion      Float?   @map("max_adverse_excursion")
  invalidated              Boolean  @default(false)
  warningsJson             Json     @default("[]") @map("warnings_json")
  evidenceJson             Json     @default("{}") @map("evidence_json")
  payloadJson              Json     @map("payload_json")

  thesis TradeThesis @relation(fields: [thesisId], references: [id])
  outcomeReview OutcomeReview? @relation(fields: [outcomeReviewId], references: [id])
  reruns ThesisEvaluationRun[]
  promotions ThesisEvaluationPromotion[]

  @@unique([workspaceId, thesisId, windowDays, evaluationStart, evaluationEnd], map: "idx_thesis_evaluations_unique_window")
  @@index([workspaceId, thesisId, evaluatedAt(sort: Desc)], map: "idx_thesis_evaluations_thesis")
  @@index([workspaceId, evaluatedAt(sort: Desc)], map: "idx_thesis_evaluations_workspace")
  @@map("thesis_evaluations")
}

model ThesisEvaluationRun {
  id                    String    @id
  workspaceId           String    @default("local") @map("workspace_id")
  canonicalEvaluationId String    @map("canonical_evaluation_id")
  thesisId              String    @map("thesis_id")
  symbol                String
  windowDays            Int       @map("window_days")
  evaluationStart       DateTime  @map("evaluation_start") @db.Date
  evaluationEnd         DateTime  @map("evaluation_end") @db.Date
  requestedByUserId     String?   @map("requested_by_user_id")
  requestedAt           DateTime  @map("requested_at") @db.Timestamptz(6)
  evaluatedAt           DateTime? @map("evaluated_at") @db.Timestamptz(6)
  source                String
  reason                String
  notes                 String?
  idempotencyKey        String?   @map("idempotency_key")
  status                String
  result                String?
  maxFavorableExcursion Float?    @map("max_favorable_excursion")
  maxAdverseExcursion   Float?    @map("max_adverse_excursion")
  invalidated           Boolean?
  warningsJson          Json      @default("[]") @map("warnings_json")
  evidenceJson          Json      @default("{}") @map("evidence_json")
  diffJson              Json      @default("{}") @map("diff_json")
  errorType             String?   @map("error_type")
  errorMessage          String?   @map("error_message")
  payloadJson           Json      @map("payload_json")

  canonicalEvaluation ThesisEvaluation @relation(fields: [canonicalEvaluationId], references: [id])
  thesis              TradeThesis       @relation(fields: [thesisId], references: [id])
  promotions          ThesisEvaluationPromotion[]

  @@index([workspaceId, canonicalEvaluationId, requestedAt(sort: Desc)], map: "idx_thesis_evaluation_runs_evaluation")
  @@index([workspaceId, thesisId, requestedAt(sort: Desc)], map: "idx_thesis_evaluation_runs_thesis")
  @@map("thesis_evaluation_runs")
}

model ThesisEvaluationPromotion {
  id                    String   @id
  workspaceId           String   @default("local") @map("workspace_id")
  canonicalEvaluationId String   @map("canonical_evaluation_id")
  promotedRerunId       String?  @map("promoted_rerun_id")
  action                String
  promotedByUserId      String?  @map("promoted_by_user_id")
  promotedAt            DateTime @map("promoted_at") @db.Timestamptz(6)
  reason                String
  notes                 String?
  idempotencyKey        String?  @map("idempotency_key")
  payloadJson           Json     @map("payload_json")

  canonicalEvaluation ThesisEvaluation    @relation(fields: [canonicalEvaluationId], references: [id])
  promotedRerun       ThesisEvaluationRun? @relation(fields: [promotedRerunId], references: [id])

  @@index([workspaceId, canonicalEvaluationId, promotedAt(sort: Desc)], map: "idx_thesis_evaluation_promotions_evaluation")
  @@map("thesis_evaluation_promotions")
}

model ProviderHealth {
  id           String   @id
  provider     String
  component    String?
  status       String
  checkedAt    DateTime @map("checked_at") @db.Timestamptz(6)
  latencyMs    Float?   @map("latency_ms")
  errorType    String?  @map("error_type")
  errorMessage String?  @map("error_message")
  payloadJson  Json     @map("payload_json")

  @@map("provider_health")
}

model LlmCall {
  id            String   @id
  researchRunId String?  @map("research_run_id")
  thesisId      String?  @map("thesis_id")
  provider      String
  model         String
  stage         String?
  agent         String?
  inputTokens   Int      @default(0) @map("input_tokens")
  outputTokens  Int      @default(0) @map("output_tokens")
  latencyMs     Float?   @map("latency_ms")
  status        String
  errorType     String?  @map("error_type")
  errorMessage  String?  @map("error_message")
  createdAt     DateTime @map("created_at") @db.Timestamptz(6)
  payloadJson   Json     @map("payload_json")

  researchRun ResearchRun? @relation(fields: [researchRunId], references: [id])
  thesis      TradeThesis? @relation(fields: [thesisId], references: [id])

  @@map("llm_calls")
}

model DataFreshnessCheck {
  id                String    @id
  researchRunId     String?   @map("research_run_id")
  symbol            String?
  source            String
  sourceTimestamp   DateTime? @map("source_timestamp") @db.Timestamptz(6)
  observedTimestamp DateTime  @map("observed_timestamp") @db.Timestamptz(6)
  ageSeconds        Int?      @map("age_seconds")
  thresholdSeconds  Int?      @map("threshold_seconds")
  status            String
  payloadJson       Json      @map("payload_json")

  researchRun ResearchRun? @relation(fields: [researchRunId], references: [id])

  @@map("data_freshness_checks")
}
