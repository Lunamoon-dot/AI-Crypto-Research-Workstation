generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id
  email       String?  @unique
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships WorkspaceMembership[]

  @@map("users")
}

model Workspace {
  id        String   @id
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships WorkspaceMembership[]

  @@map("workspaces")
}

model WorkspaceMembership {
  id          String   @id
  workspaceId String   @map("workspace_id")
  userId      String   @map("user_id")
  role        String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId], map: "idx_workspace_memberships_workspace_user")
  @@index([userId, workspaceId], map: "idx_workspace_memberships_user_workspace")
  @@map("workspace_memberships")
}

model ResearchRun {
  id                      String   @id
  workspaceId             String   @default("local") @map("workspace_id")
  symbol                  String
  assetClass              String   @map("asset_class")
  timeframe               String?
  status                  String
  startedAt               DateTime @map("started_at") @db.Timestamptz(6)
  completedAt             DateTime? @map("completed_at") @db.Timestamptz(6)
  deepThinkModel          String?  @map("deep_think_model")
  quickThinkModel         String?  @map("quick_think_model")
  llmProvider             String?  @map("llm_provider")
  configHash              String?  @map("config_hash")
  marketSnapshotId        String?  @map("market_snapshot_id")
  signalSnapshotId        String?  @map("signal_snapshot_id")
  debateId                String?  @map("debate_id")
  thesisId                String?  @map("thesis_id")
  decisionId              String?  @map("decision_id")
  userDecisionId          String?  @map("user_decision_id")
  outcomeReviewId         String?  @map("outcome_review_id")
  degradationReasonsJson  Json     @default("[]") @map("degradation_reasons_json")
  missingCoreDataJson     Json     @default("[]") @map("missing_core_data_json")
  missingOptionalDataJson Json     @default("[]") @map("missing_optional_data_json")
  payloadJson             Json     @map("payload_json")

  marketSnapshots     MarketSnapshot[]
  signalSnapshots     SignalSnapshot[]
  debates             Debate[]
  agentOpinions       AgentOpinion[]
  runEvents           RunEvent[]
  tradeTheses         TradeThesis[]
  thesisMonitorPlans  ThesisMonitorPlan[]
  thesisPulses        ThesisPulse[]
  thesisPulseMemos    ThesisPulseMemo[]
  llmCalls            LlmCall[]
  dataFreshnessChecks DataFreshnessCheck[]

  @@index([status, startedAt(sort: Desc)], map: "idx_research_runs_status")
  @@index([workspaceId, startedAt(sort: Desc)], map: "idx_research_runs_workspace_created")
  @@map("research_runs")
}

model ResearchJob {
  id                      String    @id
  runId                   String    @map("run_id")
  workspaceId             String    @map("workspace_id")
  queueBackend            String    @map("queue_backend")
  queueName               String?   @map("queue_name")
  queueJobId              String?   @map("queue_job_id")
  status                  String
  requestJson             Json      @map("request_json")
  attempts                Int       @default(0)
  maxAttempts             Int       @default(1) @map("max_attempts")
  progressJson            Json      @default("{}") @map("progress_json")
  heartbeatAt             DateTime? @map("heartbeat_at") @db.Timestamptz(6)
  cancellationRequestedAt DateTime? @map("cancellation_requested_at") @db.Timestamptz(6)
  timeoutAt               DateTime? @map("timeout_at") @db.Timestamptz(6)
  resultSummaryJson       Json?     @map("result_summary_json")
  errorCode               String?   @map("error_code")
  errorMessage            String?   @map("error_message")
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt               DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt             DateTime? @map("completed_at") @db.Timestamptz(6)
  updatedAt               DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([runId, createdAt(sort: Desc)], map: "idx_research_jobs_run_created")
  @@index([workspaceId, status, createdAt(sort: Desc)], map: "idx_research_jobs_workspace_status")
  @@index([status, heartbeatAt], map: "idx_research_jobs_heartbeat")
  @@map("research_jobs")
}

model MarketSnapshot {
  id              String    @id
  workspaceId     String    @default("local") @map("workspace_id")
  researchRunId   String?   @map("research_run_id")
  symbol          String
  capturedAt      DateTime  @map("captured_at") @db.Timestamptz(6)
  currentPrice    Float?    @map("current_price")
  source          String
  sourceTimestamp DateTime? @map("source_timestamp") @db.Timestamptz(6)
  payloadJson     Json      @map("payload_json")

  researchRun ResearchRun? @relation(fields: [researchRunId], references: [id])

  @@index([workspaceId, researchRunId], map: "idx_market_snapshots_workspace_run")
  @@index([workspaceId, symbol, capturedAt(sort: Desc)], map: "idx_market_snapshots_workspace_symbol")
  @@map("market_snapshots")
}

model SignalSnapshot {
  id                    String   @id
  workspaceId           String   @default("local") @map("workspace_id")
  researchRunId         String   @map("research_run_id")
  symbol                String
  capturedAt            DateTime @map("captured_at") @db.Timestamptz(6)
  compositeSignalId     String?  @map("composite_signal_id")
  signalCount           Int      @map("signal_count")
  bullishCount          Int      @map("bullish_count")
  bearishCount          Int      @map("bearish_count")
  neutralCount          Int      @map("neutral_count")
  staleCount            Int      @map("stale_count")
  unknownFreshnessCount Int      @map("unknown_freshness_count")
  payloadJson           Json     @map("payload_json")

  researchRun ResearchRun @relation(fields: [researchRunId], references: [id])

  @@index([workspaceId, researchRunId], map: "idx_signal_snapshots_workspace_run")
  @@index([workspaceId, symbol, capturedAt(sort: Desc)], map: "idx_signal_snapshots_workspace_symbol")
  @@map("signal_snapshots")
}

model Debate {
  id              String   @id
  workspaceId     String   @default("local") @map("workspace_id")
  researchRunId   String?  @map("research_run_id")
  symbol          String
  consensusStance String   @map("consensus_stance")
  conflictLevel   String   @map("conflict_level")
  createdAt       DateTime @map("created_at") @db.Timestamptz(6)
  payloadJson     Json     @map("payload_json")

  researchRun   ResearchRun?   @relation(fields: [researchRunId], references: [id])
  agentOpinions AgentOpinion[]

  @@index([workspaceId, researchRunId], map: "idx_debates_workspace_run")
  @@map("debates")
}

model AgentOpinion {
  id            String   @id
  workspaceId   String   @default("local") @map("workspace_id")
  debateId      String?  @map("debate_id")
  researchRunId String?  @map("research_run_id")
  agentName     String   @map("agent_name")
  agentRole     String   @map("agent_role")
  stance        String
  confidence    Float?
  createdAt     DateTime @map("created_at") @db.Timestamptz(6)
  payloadJson   Json     @map("payload_json")

  debate      Debate?      @relation(fields: [debateId], references: [id])
  researchRun ResearchRun? @relation(fields: [researchRunId], references: [id])

  @@index([workspaceId, debateId], map: "idx_agent_opinions_workspace_debate")
  @@map("agent_opinions")
}

model RunEvent {
  id            String   @id
  workspaceId   String   @default("local") @map("workspace_id")
  researchRunId String   @map("research_run_id")
  thesisId      String?  @map("thesis_id")
  eventType     String   @map("event_type")
  createdAt     DateTime @map("created_at") @db.Timestamptz(6)
  message       String
  payloadJson   Json     @map("payload_json")

  researchRun ResearchRun @relation(fields: [researchRunId], references: [id])

  @@index([researchRunId, createdAt], map: "idx_run_events_run")
  @@index([workspaceId, createdAt], map: "idx_run_events_workspace_created")
  @@map("run_events")
}

model TradeThesis {
  id            String   @id
  workspaceId   String   @default("local") @map("workspace_id")
  researchRunId String?  @map("research_run_id")
  symbol        String
  direction     String
  setupType     String   @map("setup_type")
  confidence    Float?
  createdAt     DateTime @map("created_at") @db.Timestamptz(6)
  payloadJson   Json     @map("payload_json")

  researchRun    ResearchRun?    @relation(fields: [researchRunId], references: [id])
  scenarios      Scenario[]
  watchlistItems WatchlistItem[]
  alerts         Alert[]
  userDecisions  UserDecision[]
  outcomeReviews OutcomeReview[]
  thesisEvaluations ThesisEvaluation[]
  thesisEvaluationRuns ThesisEvaluationRun[]
  llmCalls       LlmCall[]
  monitorPlans   ThesisMonitorPlan[]
  pulses         ThesisPulse[]
  pulseMemos     ThesisPulseMemo[]
  monitoringJobs MonitoringJob[]

  @@index([workspaceId, createdAt(sort: Desc)], map: "idx_trade_theses_workspace_created")
  @@map("trade_theses")
}

model ThesisMonitorPlan {
  id                            String    @id
  workspaceId                   String    @default("local") @map("workspace_id")
  thesisId                      String    @map("thesis_id")
  baselineRunId                 String?   @map("baseline_run_id")
  symbol                        String
  marketType                    String    @map("market_type")
  status                        String
  createdAt                     DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime  @map("updated_at") @db.Timestamptz(6)
  baselinePrice                 Float?    @map("baseline_price")
  baselinePriceSource           String?   @map("baseline_price_source")
  baselineObservedAt            DateTime? @map("baseline_observed_at") @db.Timestamptz(6)
  entryLow                      Float?    @map("entry_low")
  entryHigh                     Float?    @map("entry_high")
  invalidationLevel             Float?    @map("invalidation_level")
  invalidationDirection         String?   @map("invalidation_direction")
  targetsJson                   Json      @default("[]") @map("targets_json")
  scenarioTriggersJson          Json      @default("[]") @map("scenario_triggers_json")
  missingFieldsJson             Json      @default("[]") @map("missing_fields_json")
  priceIntervalMinutes          Int       @map("price_interval_minutes")
  signalIntervalMinutes         Int       @map("signal_interval_minutes")
  memoIntervalMinutes           Int       @map("memo_interval_minutes")
  watchDistancePct              Float     @map("watch_distance_pct")
  reviewDistancePct             Float     @map("review_distance_pct")
  consecutiveReviewToRerun      Int       @map("consecutive_review_to_rerun")
  consecutiveInvalidationToRerun Int       @map("consecutive_invalidation_to_rerun")
  runMemoOnReview               Boolean   @default(true) @map("run_memo_on_review")
  runMemoOnRerunFull            Boolean   @default(true) @map("run_memo_on_rerun_full")
  skipMemoIfNoNewPulses         Boolean   @default(true) @map("skip_memo_if_no_new_pulses")
  enabledSignalFactorsJson      Json      @default("[]") @map("enabled_signal_factors_json")
  schedulerEnabled              Boolean   @default(false) @map("scheduler_enabled")
  latestPulseId                 String?   @map("latest_pulse_id")
  latestMemoId                  String?   @map("latest_memo_id")
  latestStatus                  String?   @map("latest_status")
  latestPrice                   Float?    @map("latest_price")
  latestTriggerReasonsJson      Json      @default("[]") @map("latest_trigger_reasons_json")
  lastPulseAt                   DateTime? @map("last_pulse_at") @db.Timestamptz(6)
  nextPulseDueAt                DateTime? @map("next_pulse_due_at") @db.Timestamptz(6)
  lastMemoAt                    DateTime? @map("last_memo_at") @db.Timestamptz(6)
  nextMemoDueAt                 DateTime? @map("next_memo_due_at") @db.Timestamptz(6)
  payloadJson                   Json      @map("payload_json")

  thesis      TradeThesis  @relation(fields: [thesisId], references: [id])
  baselineRun ResearchRun? @relation(fields: [baselineRunId], references: [id])
  pulses      ThesisPulse[]
  memos       ThesisPulseMemo[]

  @@unique([workspaceId, thesisId], map: "idx_thesis_monitor_plans_thesis")
  @@index([workspaceId, status, updatedAt(sort: Desc)], map: "idx_thesis_monitor_plans_status")
  @@index([workspaceId, schedulerEnabled, status, nextPulseDueAt, nextMemoDueAt], map: "idx_thesis_monitor_plans_due")
  @@map("thesis_monitor_plans")
}

model ThesisPulse {
  id                           String   @id
  workspaceId                  String   @default("local") @map("workspace_id")
  thesisId                     String   @map("thesis_id")
  monitorPlanId                String   @map("monitor_plan_id")
  baselineRunId                String?  @map("baseline_run_id")
  symbol                       String
  marketType                   String   @map("market_type")
  pulseType                    String   @map("pulse_type")
  bucketStart                  DateTime @map("bucket_start") @db.Timestamptz(6)
  observedAt                   DateTime @map("observed_at") @db.Timestamptz(6)
  currentPrice                 Float?   @map("current_price")
  baselinePrice                Float?   @map("baseline_price")
  priceChangePct               Float?   @map("price_change_pct")
  distanceToEntryPct           Float?   @map("distance_to_entry_pct")
  distanceToInvalidationPct    Float?   @map("distance_to_invalidation_pct")
  nearestTarget                Float?   @map("nearest_target")
  distanceToNearestTargetPct   Float?   @map("distance_to_nearest_target_pct")
  signalBias                   String?  @map("signal_bias")
  signalConfidence             Float?   @map("signal_confidence")
  signalDelta                  Float?   @map("signal_delta")
  scenarioStatus               String?  @map("scenario_status")
  score                        Int
  status                       String
  suggestedAction              String   @map("suggested_action")
  triggerReasonsJson           Json     @default("[]") @map("trigger_reasons_json")
  hardTriggersJson             Json     @default("[]") @map("hard_triggers_json")
  missingDataJson              Json     @default("[]") @map("missing_data_json")
  payloadJson                  Json     @map("payload_json")

  thesis      TradeThesis       @relation(fields: [thesisId], references: [id])
  monitorPlan ThesisMonitorPlan @relation(fields: [monitorPlanId], references: [id])
  baselineRun ResearchRun?      @relation(fields: [baselineRunId], references: [id])

  @@unique([workspaceId, thesisId, bucketStart, pulseType], map: "idx_thesis_pulses_bucket")
  @@index([workspaceId, thesisId, observedAt(sort: Desc)], map: "idx_thesis_pulses_thesis_observed")
  @@index([workspaceId, status, observedAt(sort: Desc)], map: "idx_thesis_pulses_status")
  @@map("thesis_pulses")
}

model ThesisPulseMemo {
  id                         String   @id
  workspaceId                String   @default("local") @map("workspace_id")
  thesisId                   String   @map("thesis_id")
  monitorPlanId              String   @map("monitor_plan_id")
  baselineRunId              String?  @map("baseline_run_id")
  memoType                   String   @map("memo_type")
  windowStart                DateTime @map("window_start") @db.Timestamptz(6)
  windowEnd                  DateTime @map("window_end") @db.Timestamptz(6)
  createdAt                  DateTime @map("created_at") @db.Timestamptz(6)
  status                     String
  summary                    String
  whatChangedJson            Json     @default("[]") @map("what_changed_json")
  whyItMattersJson           Json     @default("[]") @map("why_it_matters_json")
  whatToWatchNextJson        Json     @default("[]") @map("what_to_watch_next_json")
  recommendedAction          String   @map("recommended_action")
  rerunFullRecommended       Boolean  @default(false) @map("rerun_full_recommended")
  confidence                 Float?
  referencedPulseIdsJson     Json     @default("[]") @map("referenced_pulse_ids_json")
  promptVersion              String   @map("prompt_version")
  provider                   String
  model                      String
  payloadJson                Json     @map("payload_json")

  thesis      TradeThesis       @relation(fields: [thesisId], references: [id])
  monitorPlan ThesisMonitorPlan @relation(fields: [monitorPlanId], references: [id])
  baselineRun ResearchRun?      @relation(fields: [baselineRunId], references: [id])

  @@unique([workspaceId, thesisId, windowStart, windowEnd, memoType], map: "idx_thesis_pulse_memos_window")
  @@index([workspaceId, thesisId, createdAt(sort: Desc)], map: "idx_thesis_pulse_memos_thesis_created")
  @@index([workspaceId, status, createdAt(sort: Desc)], map: "idx_thesis_pulse_memos_status")
  @@map("thesis_pulse_memos")
}

model MonitoringJob {
  id             String    @id
  workspaceId    String    @map("workspace_id")
  thesisId       String?   @map("thesis_id")
  jobType        String    @map("job_type")
  status         String
  priority       Int       @default(0)
  runAfter       DateTime  @default(now()) @map("run_after") @db.Timestamptz(6)
  attemptCount   Int       @default(0) @map("attempt_count")
  maxAttempts    Int       @default(3) @map("max_attempts")
  lockedAt       DateTime? @map("locked_at") @db.Timestamptz(6)
  lockedBy       String?   @map("locked_by")
  startedAt      DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  errorType      String?   @map("error_type")
  errorMessage   String?   @map("error_message")
  idempotencyKey String    @map("idempotency_key")
  requestJson    Json      @map("request_json")
  resultJson     Json?     @map("result_json")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  thesis TradeThesis? @relation(fields: [thesisId], references: [id])

  @@unique([workspaceId, idempotencyKey], map: "idx_monitoring_jobs_idempotency")
  @@index([workspaceId, status, runAfter, priority(sort: Desc), createdAt], map: "idx_monitoring_jobs_due")
  @@index([workspaceId, thesisId, createdAt(sort: Desc)], map: "idx_monitoring_jobs_thesis")
  @@index([status, lockedBy, lockedAt], map: "idx_monitoring_jobs_workers")
  @@map("monitoring_jobs")
}

model MonitoringRetentionRun {
  id            String    @id
  workspaceId   String    @map("workspace_id")
  startedAt     DateTime  @map("started_at") @db.Timestamptz(6)
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(6)
  dryRun        Boolean   @map("dry_run")
  deletedPulses Int       @default(0) @map("deleted_pulses")
  deletedMemos  Int       @default(0) @map("deleted_memos")
  deletedJobs   Int       @default(0) @map("deleted_jobs")
  error         String?
  policyJson    Json      @map("policy_json")
  payloadJson   Json      @map("payload_json")

  @@index([workspaceId, startedAt(sort: Desc)], map: "idx_monitoring_retention_runs_workspace_started")
  @@map("monitoring_retention_runs")
}

model Scenario {
  id                  String @id
  workspaceId         String @default("local") @map("workspace_id")
  thesisId            String @map("thesis_id")
  probabilityBand     String @map("probability_band")
  suggestedUserAction String @map("suggested_user_action")
  payloadJson         Json   @map("payload_json")

  thesis TradeThesis @relation(fields: [thesisId], references: [id])

  @@index([workspaceId, thesisId], map: "idx_scenarios_workspace_thesis")
  @@map("scenarios")
}

model Signal {
  id              String    @id
  workspaceId     String    @default("local") @map("workspace_id")
  symbol          String
  signalType      String    @map("signal_type")
  direction       String
  confidence      Float?
  observedAt      DateTime  @map("observed_at") @db.Timestamptz(6)
  source          String
  sourceTimestamp DateTime? @map("source_timestamp") @db.Timestamptz(6)
  payloadJson     Json      @map("payload_json")

  @@index([workspaceId, observedAt(sort: Desc)], map: "idx_signals_workspace_observed")
  @@map("signals")
}

model Watchlist {
  id          String   @id
  workspaceId String   @default("local") @map("workspace_id")
  name        String
  enabled     Int
  createdAt   DateTime @map("created_at") @db.Timestamptz(6)
  payloadJson Json     @map("payload_json")

  items WatchlistItem[]

  @@unique([workspaceId, name], map: "idx_watchlists_workspace_name")
  @@index([workspaceId, createdAt(sort: Desc)], map: "idx_watchlists_workspace_created")
  @@map("watchlists")
}

model WatchlistItem {
  id          String   @id
  workspaceId String   @default("local") @map("workspace_id")
  watchlistId String   @map("watchlist_id")
  itemType    String   @map("item_type")
  symbol      String?
  thesisId    String?  @map("thesis_id")
  setupType   String?  @map("setup_type")
  enabled     Int
  createdAt   DateTime @map("created_at") @db.Timestamptz(6)
  payloadJson Json     @map("payload_json")

  watchlist Watchlist    @relation(fields: [watchlistId], references: [id])
  thesis    TradeThesis? @relation(fields: [thesisId], references: [id])
  alerts    Alert[]

  @@index([workspaceId, watchlistId], map: "idx_watchlist_items_workspace_watchlist")
  @@map("watchlist_items")
}

model Alert {
  id              String    @id
  workspaceId     String    @default("local") @map("workspace_id")
  alertType       String    @map("alert_type")
  symbol          String
  thesisId        String?   @map("thesis_id")
  watchlistItemId String?   @map("watchlist_item_id")
  triggerKey      String?   @map("trigger_key")
  createdAt       DateTime  @map("created_at") @db.Timestamptz(6)
  readAt          DateTime? @map("read_at") @db.Timestamptz(6)
  message         String
  payloadJson     Json      @map("payload_json")

  thesis        TradeThesis?   @relation(fields: [thesisId], references: [id])
  watchlistItem WatchlistItem? @relation(fields: [watchlistItemId], references: [id])

  @@index([workspaceId, createdAt(sort: Desc)], map: "idx_alerts_workspace_created")
  @@index([workspaceId, symbol, createdAt(sort: Desc)], map: "idx_alerts_workspace_symbol")
  @@index([workspaceId, thesisId, createdAt(sort: Desc)], map: "idx_alerts_workspace_thesis")
  @@map("alerts")
}

model MarketBrief {
  id              String   @id
  workspaceId     String   @default("local") @map("workspace_id")
  briefDate       DateTime @map("brief_date") @db.Date
  watchlistName   String   @map("watchlist_name")
  title           String
  createdAt       DateTime @map("created_at") @db.Timestamptz(6)
  previousBriefId String?  @map("previous_brief_id")
  payloadJson     Json     @map("payload_json")

  @@index([workspaceId, createdAt(sort: Desc)], map: "idx_market_briefs_workspace_created")
  @@map("market_briefs")
}

model UserDecision {
  id          String   @id
  thesisId    String   @map("thesis_id")
  action      String
  decidedAt   DateTime @map("decided_at") @db.Timestamptz(6)
  userNotes   String   @map("user_notes")
  payloadJson Json     @map("payload_json")

  thesis TradeThesis @relation(fields: [thesisId], references: [id])

  @@map("user_decisions")
}

model OutcomeReview {
  id          String   @id
  thesisId    String   @map("thesis_id")
  result      String
  reviewedAt  DateTime @map("reviewed_at") @db.Timestamptz(6)
  invalidated Int
  payloadJson Json     @map("payload_json")

  thesis TradeThesis @relation(fields: [thesisId], references: [id])
  thesisEvaluations ThesisEvaluation[]

  @@map("outcome_reviews")
}

model ThesisEvaluation {
  id                       String   @id
  workspaceId              String   @default("local") @map("workspace_id")
  thesisId                 String   @map("thesis_id")
  outcomeReviewId          String?  @map("outcome_review_id")
  symbol                   String
  windowDays               Int      @map("window_days")
  evaluationStart          DateTime @map("evaluation_start") @db.Date
  evaluationEnd            DateTime @map("evaluation_end") @db.Date
  evaluatedAt              DateTime @map("evaluated_at") @db.Timestamptz(6)
  result                   String
  maxFavorableExcursion    Float?   @map("max_favorable_excursion")
  maxAdverseExcursion      Float?   @map("max_adverse_excursion")
  invalidated              Boolean  @default(false)
  warningsJson             Json     @default("[]") @map("warnings_json")
  evidenceJson             Json     @default("{}") @map("evidence_json")
  payloadJson              Json     @map("payload_json")

  thesis TradeThesis @relation(fields: [thesisId], references: [id])
  outcomeReview OutcomeReview? @relation(fields: [outcomeReviewId], references: [id])
  reruns ThesisEvaluationRun[]
  promotions ThesisEvaluationPromotion[]

  @@unique([workspaceId, thesisId, windowDays, evaluationStart, evaluationEnd], map: "idx_thesis_evaluations_unique_window")
  @@index([workspaceId, thesisId, evaluatedAt(sort: Desc)], map: "idx_thesis_evaluations_thesis")
  @@index([workspaceId, evaluatedAt(sort: Desc)], map: "idx_thesis_evaluations_workspace")
  @@map("thesis_evaluations")
}

model ThesisEvaluationRun {
  id                    String    @id
  workspaceId           String    @default("local") @map("workspace_id")
  canonicalEvaluationId String    @map("canonical_evaluation_id")
  thesisId              String    @map("thesis_id")
  symbol                String
  windowDays            Int       @map("window_days")
  evaluationStart       DateTime  @map("evaluation_start") @db.Date
  evaluationEnd         DateTime  @map("evaluation_end") @db.Date
  requestedByUserId     String?   @map("requested_by_user_id")
  requestedAt           DateTime  @map("requested_at") @db.Timestamptz(6)
  evaluatedAt           DateTime? @map("evaluated_at") @db.Timestamptz(6)
  source                String
  reason                String
  notes                 String?
  idempotencyKey        String?   @map("idempotency_key")
  status                String
  result                String?
  maxFavorableExcursion Float?    @map("max_favorable_excursion")
  maxAdverseExcursion   Float?    @map("max_adverse_excursion")
  invalidated           Boolean?
  warningsJson          Json      @default("[]") @map("warnings_json")
  evidenceJson          Json      @default("{}") @map("evidence_json")
  diffJson              Json      @default("{}") @map("diff_json")
  errorType             String?   @map("error_type")
  errorMessage          String?   @map("error_message")
  payloadJson           Json      @map("payload_json")

  canonicalEvaluation ThesisEvaluation @relation(fields: [canonicalEvaluationId], references: [id])
  thesis              TradeThesis       @relation(fields: [thesisId], references: [id])
  promotions          ThesisEvaluationPromotion[]

  @@index([workspaceId, canonicalEvaluationId, requestedAt(sort: Desc)], map: "idx_thesis_evaluation_runs_evaluation")
  @@index([workspaceId, thesisId, requestedAt(sort: Desc)], map: "idx_thesis_evaluation_runs_thesis")
  @@map("thesis_evaluation_runs")
}

model ThesisEvaluationPromotion {
  id                    String   @id
  workspaceId           String   @default("local") @map("workspace_id")
  canonicalEvaluationId String   @map("canonical_evaluation_id")
  promotedRerunId       String?  @map("promoted_rerun_id")
  action                String
  promotedByUserId      String?  @map("promoted_by_user_id")
  promotedAt            DateTime @map("promoted_at") @db.Timestamptz(6)
  reason                String
  notes                 String?
  idempotencyKey        String?  @map("idempotency_key")
  payloadJson           Json     @map("payload_json")

  canonicalEvaluation ThesisEvaluation    @relation(fields: [canonicalEvaluationId], references: [id])
  promotedRerun       ThesisEvaluationRun? @relation(fields: [promotedRerunId], references: [id])

  @@index([workspaceId, canonicalEvaluationId, promotedAt(sort: Desc)], map: "idx_thesis_evaluation_promotions_evaluation")
  @@map("thesis_evaluation_promotions")
}

model ProviderHealth {
  id           String   @id
  provider     String
  component    String?
  status       String
  checkedAt    DateTime @map("checked_at") @db.Timestamptz(6)
  latencyMs    Float?   @map("latency_ms")
  errorType    String?  @map("error_type")
  errorMessage String?  @map("error_message")
  payloadJson  Json     @map("payload_json")

  @@map("provider_health")
}

model LlmCall {
  id            String   @id
  researchRunId String?  @map("research_run_id")
  thesisId      String?  @map("thesis_id")
  provider      String
  model         String
  stage         String?
  agent         String?
  inputTokens   Int      @default(0) @map("input_tokens")
  outputTokens  Int      @default(0) @map("output_tokens")
  latencyMs     Float?   @map("latency_ms")
  status        String
  errorType     String?  @map("error_type")
  errorMessage  String?  @map("error_message")
  createdAt     DateTime @map("created_at") @db.Timestamptz(6)
  payloadJson   Json     @map("payload_json")

  researchRun ResearchRun? @relation(fields: [researchRunId], references: [id])
  thesis      TradeThesis? @relation(fields: [thesisId], references: [id])

  @@map("llm_calls")
}

model DataFreshnessCheck {
  id                String    @id
  researchRunId     String?   @map("research_run_id")
  symbol            String?
  source            String
  sourceTimestamp   DateTime? @map("source_timestamp") @db.Timestamptz(6)
  observedTimestamp DateTime  @map("observed_timestamp") @db.Timestamptz(6)
  ageSeconds        Int?      @map("age_seconds")
  thresholdSeconds  Int?      @map("threshold_seconds")
  status            String
  payloadJson       Json      @map("payload_json")

  researchRun ResearchRun? @relation(fields: [researchRunId], references: [id])

  @@map("data_freshness_checks")
}
